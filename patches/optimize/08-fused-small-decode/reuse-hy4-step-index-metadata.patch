+def _shared_swa_indices(context, positions, window):
+    cache = context.additional_kwargs.setdefault("hy4_swa_selection", {})
+    key = (positions.data_ptr(), positions.shape, positions.stride(), window)
+    if key not in cache:
+        cache[key] = _swa_indices(positions, window)
+    return cache[key]
+
