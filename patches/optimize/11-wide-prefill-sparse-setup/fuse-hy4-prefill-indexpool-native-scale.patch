+# SPDX-License-Identifier: Apache-2.0
+"""Fuse the seven FP32 Hadamard stages for wide IndexPool inputs."""
+
+import torch
+from vllm.triton_utils import HAS_TRITON, tl, triton
+
+
+def supports_prefill_fwht(rows):
+    return (
+        HAS_TRITON and rows.device.type == "npu" and rows.dtype == torch.bfloat16
+        and rows.ndim == 2 and rows.shape[1] == 128 and 128 < rows.shape[0] <= 32768
+        and rows.is_contiguous()
+    )
+
+
+@triton.jit
+def _fwht_rows(input_ptr, output_ptr, peaks_ptr, ROWS: tl.constexpr, ROW_TILE: tl.constexpr):
+    rows = tl.program_id(0) * ROW_TILE + tl.arange(0, ROW_TILE)
+    lane = tl.arange(0, 128)
+    offsets = rows[:, None] * 128 + lane[None, :]
+    valid = rows < ROWS
+    values = tl.load(input_ptr + offsets, valid[:, None], other=0).to(tl.float32)
+    for step in tl.static_range(0, 7):
+        stride = 1 << step
+        partner = tl.broadcast_to((lane ^ stride)[None, :], (ROW_TILE, 128))
+        other = tl.gather(values, partner, axis=1)
+        values = tl.where((lane[None, :] & stride) != 0, other - values, values + other)
+    values *= 128 ** -0.5
+    peak = tl.max(tl.abs(values), axis=1)
+    tl.store(output_ptr + offsets, values, valid[:, None])
+    tl.store(peaks_ptr + rows, peak, valid)
+
+
+def prefill_fwht(rows):
+    transformed = torch.empty_like(rows, dtype=torch.float32)
+    peaks = rows.new_empty((rows.shape[0],), dtype=torch.float32)
+    tile = 16
+    _fwht_rows[(triton.cdiv(rows.shape[0], tile),)](
+        rows, transformed, peaks, rows.shape[0], tile, num_warps=4, enable_fp_fusion=False,
+    )
+    return transformed, peaks
+
+
+@triton.jit
+def _round_with_scale(transformed_ptr, scale_ptr, result_ptr, ROWS: tl.constexpr, ROW_TILE: tl.constexpr):
+    row = tl.program_id(0) * ROW_TILE + tl.arange(0, ROW_TILE)
+    column = tl.arange(0, 128)
+    valid = row < ROWS
+    offsets = row[:, None] * 128 + column[None, :]
+    scale = tl.load(scale_ptr + row, valid, other=1.0)
+    source = tl.load(transformed_ptr + offsets, valid[:, None], other=0) / scale[:, None]
+    magnitude = tl.minimum(tl.abs(source), 448.0)
+    bits = magnitude.to(tl.int32, bitcast=True)
+    retained = ((bits & 0x100000) != 0).to(tl.int32)
+    normal = ((bits + 0x7FFFF + retained) & -0x100000).to(tl.float32, bitcast=True)
+    ticks = magnitude * 512.0
+    whole = ticks.to(tl.int32)
+    fraction = ticks - whole.to(tl.float32)
+    round_up = (fraction > 0.5) | ((fraction == 0.5) & ((whole & 1) != 0))
+    subnormal = (whole + round_up.to(tl.int32)).to(tl.float32) * (1.0 / 512.0)
+    rounded = tl.where(magnitude < 1.0 / 64.0, subnormal, normal)
+    signed = tl.where(source < 0.0, -rounded, rounded)
+    tl.store(result_ptr + offsets, signed * scale[:, None], valid[:, None])
+
+
+def quantize_prefill_fwht(transformed, scales):
+    output = transformed.new_empty(transformed.shape, dtype=torch.bfloat16)
+    rows = transformed.shape[0]
+    tile = 16
+    _round_with_scale[(triton.cdiv(rows, tile),)](
+        transformed, scales, output, rows, tile, num_warps=4, enable_fp_fusion=False,
+    )
+    return output
