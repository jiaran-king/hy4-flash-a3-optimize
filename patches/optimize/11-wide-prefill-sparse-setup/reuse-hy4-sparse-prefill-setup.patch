@@ -0,0 +1,48 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Read contiguous prefill KV spans by page and write the sparse sink epilogue."""
+
+import torch
+from vllm.triton_utils import HAS_TRITON, tl, triton
+
+
+def prefill_pages(block_table, first, end, block_size):
+    first_page = first // block_size
+    last_page = (end + block_size - 1) // block_size
+    return block_table[first_page:last_page].long()
+
+
+def read_prefill_span(latent_cache, rope_cache, pages, first, end):
+    offset = first % latent_cache.shape[1]
+    selected = slice(offset, offset + end - first)
+    return (latent_cache.index_select(0, pages).flatten(0, 1)[selected],
+            rope_cache.index_select(0, pages).flatten(0, 1)[selected])
+
+
+def supports_sink_write(attended, coefficient, denominator, output):
+    return (
+        HAS_TRITON and attended.device.type == "npu" and attended.ndim == 3
+        and attended.shape == output.shape and attended.shape[-1] == 512
+        and attended.dtype == output.dtype == torch.bfloat16
+        and attended.shape[:2] == coefficient.shape == denominator.shape
+        and coefficient.dtype == denominator.dtype == torch.float32
+        and attended.is_contiguous() and output.is_contiguous()
+        and coefficient.is_contiguous() and denominator.is_contiguous()
+    )
+
+
+@triton.jit(do_not_specialize=["rows_total"])
+def _write_sink(input_ptr, factor_ptr, sum_ptr, output_ptr, rows_total):
+    row = tl.program_id(0) * 4 + tl.arange(0, 4)
+    column = tl.arange(0, 512)
+    offsets = row[:, None] * 512 + column[None, :]
+    valid = row < rows_total
+    attended = tl.load(input_ptr + offsets, valid[:, None], other=0).to(tl.float32)
+    attenuation = tl.load(factor_ptr + row, valid, other=0)
+    denominator = tl.load(sum_ptr + row, valid, other=0)
+    value = tl.where(denominator[:, None] == 0, 0.0, attended * attenuation[:, None])
+    tl.store(output_ptr + offsets, value, valid[:, None])
+
+
+def write_sparse_sink(attended, coefficient, denominator, output):
+    rows = attended.shape[0] * attended.shape[1]
+    _write_sink[(triton.cdiv(rows, 4),)](attended, coefficient, denominator, output, rows, num_warps=4)
