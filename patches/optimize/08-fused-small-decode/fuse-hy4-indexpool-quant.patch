+++ b/workspace/runtime-01/vllm-ascend/vllm_ascend/ops/triton/hy4_indexpool_quant.py
@@ -0,0 +1,54 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Fused small-batch transform and E4M3FN rounding for HY4 IndexPool."""
+
+import torch
+from vllm.triton_utils import HAS_TRITON, tl, triton
+
+
+def supports_indexpool_quant(vectors: torch.Tensor) -> bool:
+    return (
+        HAS_TRITON and vectors.device.type == "npu" and vectors.dtype == torch.bfloat16
+        and vectors.ndim == 2 and vectors.shape[1] == 128
+        and 0 < vectors.shape[0] <= 128 and vectors.is_contiguous()
+    )
+
+
+@triton.jit
+def _quantize_index_rows(vectors_ptr, output_ptr):
+    row = tl.program_id(0)
+    lane = tl.arange(0, 128)
+    values = tl.load(vectors_ptr + row * 128 + lane).to(tl.float32)
+    for step in tl.static_range(0, 7):
+        stride = 1 << step
+        other = tl.gather(values, lane ^ stride, axis=0)
+        values = tl.where((lane & stride) != 0, other - values, values + other)
+    values *= 128 ** -0.5
+
+    # The ceiling of log2 of a positive normal FP32 value follows its exponent
+    # and whether any mantissa bit remains. Construct the scale as a power of two.
+    peak = tl.maximum(tl.max(tl.abs(values), axis=0), 0.0001) * (1.0 / 448.0)
+    bits = peak.to(tl.int32, bitcast=True)
+    biased_exp = (bits >> 23) + ((bits & 0x7FFFFF) != 0).to(tl.int32)
+    scale = (biased_exp << 23).to(tl.float32, bitcast=True)
+    values = values / scale
+    magnitude = tl.minimum(tl.abs(values), 448.0)
+
+    bits = magnitude.to(tl.int32, bitcast=True)
+    retained = ((bits & 0x100000) != 0).to(tl.int32)
+    normal = ((bits + 0x7FFFF + retained) & -0x100000).to(tl.float32, bitcast=True)
+    ticks = magnitude * 512.0
+    whole = ticks.to(tl.int32)
+    fraction = ticks - whole.to(tl.float32)
+    round_up = (fraction > 0.5) | ((fraction == 0.5) & ((whole & 1) != 0))
+    subnormal = ((whole + round_up.to(tl.int32)).to(tl.float32)) * (1.0 / 512.0)
+    rounded = tl.where(magnitude < 1.0 / 64.0, subnormal, normal)
+    signed = tl.where(values < 0.0, -rounded, rounded)
+    tl.store(output_ptr + row * 128 + lane, signed * scale)
+
+
+def quantize_indexpool_rows(vectors: torch.Tensor) -> torch.Tensor:
+    output = torch.empty_like(vectors)
+    _quantize_index_rows[(vectors.shape[0],)](
+        vectors, output, num_warps=4, enable_fp_fusion=False,
+    )
+    return output
