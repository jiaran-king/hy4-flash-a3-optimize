+def select_prefill_groups(query, weights, keys, positions, ratio, budget, tile_size):
+    queries, heads, dimension = query.shape
+    groups = keys.shape[0]
+    if groups <= budget:
+        chosen = torch.arange(budget, device=query.device, dtype=torch.int32).expand(queries, -1)
+    else:
+        # Bound the per-head score tile, but select and expand the groups once
+        # for the entire prefill span.
+        transposed_keys = keys.float().T
+        scores = torch.empty((queries, groups), device=query.device, dtype=torch.float32)
+        for start in range(0, queries, tile_size):
+            end = min(queries, start + tile_size)
+            projected = query[start:end].reshape(-1, dimension).float() @ transposed_keys
+            weighted = projected.reshape(end - start, heads, groups).relu_() * weights[start:end, :, None]
+            scores[start:end].copy_(weighted.sum(1))
+        chosen = select_ordered_groups(scores, positions // ratio, budget)
+    return expand_ordered_groups(chosen, positions, ratio)
