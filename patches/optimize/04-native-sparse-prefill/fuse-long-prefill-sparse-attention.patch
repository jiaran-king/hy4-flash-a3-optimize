+def _sparse_prefill(query, query_rope, latent, rope, indexes, sinks, scale):
+    import torch_npu
+
+    # The operator returns the ordinary attention output plus statistics for
+    # the same FP32 softmax denominator. A zero-value sink only changes that
+    # denominator, so rescale the output using the sink logit.
+    lengths_q = torch.tensor([query.shape[0]], device=query.device, dtype=torch.int32)
+    lengths_kv = torch.tensor([latent.shape[0]], device=query.device, dtype=torch.int32)
+    attended, maximum, exp_sum = torch_npu.npu_sparse_flash_attention(
+        query.contiguous(), latent, latent, indexes[:, None, :].contiguous(), scale,
+        query_rope=query_rope.contiguous(), key_rope=rope,
+        actual_seq_lengths_query=lengths_q, actual_seq_lengths_kv=lengths_kv,
+        layout_query="TND", layout_kv="TND", sparse_mode=3, attention_mode=2,
+        return_softmax_lse=True,
+    )
+    maximum = maximum.squeeze(0)
+    exp_sum = exp_sum.squeeze(0)
+    attenuation = torch.sigmoid(maximum + exp_sum.log() - sinks.float())
+    output = attended.float() * attenuation[..., None]
+    return output.masked_fill_(exp_sum[..., None] == 0, 0)
+
