+def _shared_swa_tile(
+    query_latent, query_rope, flat_latent, flat_rope, block_table,
+    first_query, window, block_size, sinks, scale,
+):
+    queries, heads, dimension = query_latent.shape
+    first_key = max(0, first_query + 1 - window)
+    key_positions = torch.arange(
+        first_key, first_query + queries, device=query_latent.device, dtype=torch.long
+    )
+    blocks = block_table.index_select(0, key_positions // block_size).long()
+    slots = blocks * block_size + key_positions % block_size
+    latent = flat_latent.index_select(0, slots).float()
+    rope = flat_rope.index_select(0, slots).float()
+    q_latent = query_latent.reshape(queries * heads, dimension).float()
+    q_rope = query_rope.reshape(queries * heads, query_rope.shape[-1]).float()
+    logits = (q_latent @ latent.T + q_rope @ rope.T).reshape(queries, heads, -1) * scale
+    query_positions = first_query + torch.arange(queries, device=query_latent.device)
+    valid = (key_positions <= query_positions[:, None]) & (
+        key_positions > query_positions[:, None] - window
+    )
+    logits.masked_fill_(~valid[:, None, :], -torch.inf)
+    sink = sinks.float().reshape(1, -1, 1).expand(queries, -1, 1)
+    weights = torch.cat((logits, sink), dim=-1).softmax(dim=-1)[..., :-1]
+    return (weights.reshape(queries * heads, -1) @ latent).reshape_as(query_latent)
+
