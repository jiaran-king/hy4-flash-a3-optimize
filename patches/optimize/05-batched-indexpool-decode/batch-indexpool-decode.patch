+def decode_group_slots(block_tables, group_counts, block_size):
+    counts = torch.tensor(group_counts, device=block_tables.device)
+    groups = torch.arange(max(group_counts), device=block_tables.device)
+    positions = groups[None, :].expand(counts.numel(), -1)
+    positions = positions.masked_fill(positions >= counts[:, None], 0)
+    pages = block_tables.gather(1, positions // block_size)
+    return pages.long() * block_size + positions % block_size
