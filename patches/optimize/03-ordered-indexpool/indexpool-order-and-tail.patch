+# SPDX-License-Identifier: Apache-2.0
+"""IndexPool group ordering and token expansion for the Ascend A3 path."""
+
+import torch
+import torch.nn.functional as F
+
+
+def select_ordered_groups(logits, upper, budget):
+    groups = logits.shape[1]
+    # FP32 can represent each eligible group id and the sentinel exactly.
+    if groups > 2**24:
+        from vllm.models.hy_v4_flash.nvidia.indexpool_ops import select_groups
+
+        return select_groups(logits, upper, budget)
+
+    columns = torch.arange(groups, device=logits.device)
+    scores = logits.masked_fill(columns[None] >= upper[:, None], -torch.inf)
+    count = min(budget, groups)
+    values, indices = scores.topk(count, dim=-1)
+    # Sorting integer indices falls back to AICPU on A3.
+    ordered = torch.where(values != -torch.inf, indices, groups).float().sort(dim=-1).values
+    ordered.masked_fill_(ordered == groups, -1)
+    return F.pad(ordered.int(), (0, budget - count), value=-1)
+
+
+def expand_ordered_groups(group_ids, positions, ratio):
+    """Expand a prefix of ascending history ids and append the causal tail."""
+    offsets = torch.arange(ratio, dtype=torch.int32, device=group_ids.device)
+    upper = positions // ratio
+    live = positions >= 0
+    valid = (group_ids >= 0) & (group_ids < upper[:, None]) & live[:, None]
+    history = (group_ids[..., None] * ratio + offsets).masked_fill(~valid[..., None], -1)
+    tail = upper[:, None] * ratio + offsets
+    tail = tail.masked_fill(~live[:, None] | (tail > positions[:, None]), -1).int()
+    tail_start = valid.sum(dim=-1, dtype=torch.int32) * ratio
+    destinations = (tail_start[:, None] + offsets).long()
+    # Ordered groups leave their invalid entries at the end. Only the tail moves.
+    padded = F.pad(history.flatten(1), (0, ratio), value=-1)
+    return padded.scatter_(1, destinations, tail)
