+# SPDX-License-Identifier: Apache-2.0
+"""Update iHC residual channels as the following gate projection reads them."""
+
+import torch
+from vllm.triton_utils import tl, triton
+
+from vllm_ascend.ops.triton.hy4_ihc_project import _reduce_projected
+
+
+@triton.jit
+def _update_and_project(
+    output_ptr, previous_ptr, gate_ptr, weight_ptr, updated_ptr, partial_ptr,
+    DIM: tl.constexpr, TILE: tl.constexpr,
+):
+    token = tl.program_id(0)
+    split = tl.program_id(1)
+    width: tl.constexpr = 4 * DIM
+    splits: tl.constexpr = width // TILE
+    column = split * TILE + tl.arange(0, TILE)
+    branch = (split * TILE) // DIM
+    output = tl.load(output_ptr + token * DIM + column - branch * DIM).to(tl.float32)
+    previous = tl.load(previous_ptr + token * width + column).to(tl.float32)
+    gate = tl.load(gate_ptr + token * 4 + branch)
+    # The subsequent projection consumes the BF16-rounded residual.
+    updated = (gate * output + previous).to(tl.bfloat16)
+    tl.store(updated_ptr + token * width + column, updated)
+    residual = updated.to(tl.float32)
+    lanes = tl.arange(0, 8)
+    weights = tl.load(weight_ptr + lanes[:, None] * width + column[None, :])
+    projected = tl.sum(residual[None, :] * weights, axis=1)
+    squared = tl.sum(residual * residual, axis=0)
+    partial = partial_ptr + (token * splits + split) * 16
+    tl.store(partial + lanes, projected)
+    tl.store(partial + 8, squared)
+
+
+def project_decode_ihc_after_update(output, previous, gates, weight, scale, base, norm_eps, gate_eps, magnitude):
+    tokens, branches, dim = previous.shape
+    tile = 512
+    splits = branches * dim // tile
+    partial = weight.new_empty((tokens, splits, 16), dtype=torch.float32)
+    updated = torch.empty_like(previous)
+    reduced = previous.new_empty((tokens, dim))
+    post = weight.new_empty((tokens, branches), dtype=torch.float32)
+    _update_and_project[(tokens, splits)](
+        output, previous, gates, weight, updated, partial, dim, tile, num_warps=4, enable_fp_fusion=False,
+    )
+    _reduce_projected[(tokens, dim // tile)](
+        updated, partial, scale, base, reduced, post, dim, splits, triton.next_power_of_2(splits),
+        tile, norm_eps, gate_eps, magnitude, num_warps=4, enable_fp_fusion=False,
+    )
+    return reduced, post, updated
