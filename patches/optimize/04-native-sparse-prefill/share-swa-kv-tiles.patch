+def _has_contiguous_logical_positions(context, metadata, positions):
+    ends = tuple(metadata.actual_seq_lengths_q)
+    lengths = tuple(metadata.seq_lens_list)
+    starts = (0, *ends[:-1])
+    intervals = tuple(end - begin for begin, end in zip(starts, ends, strict=True))
+    if all(count <= 1 for count in intervals):
+        return False
+    key = (ends, lengths, positions.data_ptr())
+    checked = context.additional_kwargs.setdefault("hy4_window_position_checks", {})
+    if key not in checked:
+        # Check once per forward so every SWA layer can use the same safe layout.
+        logical = [
+            index for length, count in zip(lengths, intervals, strict=True)
+            for index in range(length - count, length)
+        ]
+        expected = torch.tensor(logical, dtype=positions.dtype, device=positions.device)
+        checked[key] = torch.equal(positions, expected)
+    return checked[key]
+
