+def _attend_slots(
+    query_latent, query_rope, flat_latent, flat_rope, slots, valid, sinks, scale
+):
+    queries, width = valid.shape
+    slots = slots.flatten()
+    vectors = flat_latent.index_select(0, slots).reshape(queries, width, flat_latent.shape[-1]).float()
+    rope = flat_rope.index_select(0, slots).reshape(queries, width, flat_rope.shape[-1]).float()
+    logits = (
+        torch.bmm(query_latent.float(), vectors.transpose(1, 2))
+        + torch.bmm(query_rope.float(), rope.transpose(1, 2))
+    ) * scale
+    logits.masked_fill_(~valid[:, None, :], -torch.inf)
+    sink = sinks.float().reshape(1, -1, 1).expand(queries, -1, 1)
+    weights = torch.cat((logits, sink), dim=-1).softmax(dim=-1)[..., :-1]
+    return torch.bmm(weights, vectors)
 
 
