+            return super().pre(hidden_states)
+        pre = self.hc_pre
+        mixes = pre.hc_fn(hidden_states.flatten(1).float())[0].contiguous()
+        reduced, gates = decode_ihc_pre(hidden_states, mixes, pre.hc_scale, pre.hc_base,
+                                        pre.layernorm_epsilon, pre.hc_eps, pre.magnitude)
+        return reduced, gates, hidden_states
+
+    def post(self, output_with_bias, residual, post_gates):
+        if (self.use_a3_ihc and self.enable_ihc and self.hc_post.hpc_op is None
+                and supports_decode_ihc(residual) and post_gates is not None
+                and post_gates.dtype == torch.float32 and post_gates.is_contiguous()
+                and post_gates.shape == residual.shape[:2]
+                and output_with_bias.dtype == residual.dtype and output_with_bias.is_contiguous()
+                and output_with_bias.shape == (residual.shape[0], residual.shape[2])):
+            return decode_ihc_post(output_with_bias, residual, post_gates)
+        return super().post(output_with_bias, residual, post_gates)
