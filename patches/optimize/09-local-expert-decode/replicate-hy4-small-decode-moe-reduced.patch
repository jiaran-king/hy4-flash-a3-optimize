+def _use_hy4_local_expert_decode(vllm_config, attn_metadata, num_tokens):
+    if num_tokens is None or not 0 < num_tokens <= 4 or not isinstance(attn_metadata, dict):
+        return False
+    model = vllm_config.model_config
+    text = getattr(model, "hf_text_config", None)
+    if getattr(text, "model_type", None) != "hy_v4_flash":
+        return False
+    parallel = vllm_config.parallel_config
+    if (
+        not get_current_hardware_profile().supports(HardwareCapability.HY4_LOCAL_EXPERT_FP32_REDUCE)
+        or not model.enforce_eager
+        or model.dtype != torch.bfloat16
+        or model.quantization is not None
+        or vllm_config.speculative_config is not None
+        or vllm_config.lora_config is not None
+        or text.n_routed_experts != 512
+        or text.num_experts_per_tok != 16
+        or text.routed_expert_hidden_size != 1536
+        or parallel.tensor_parallel_size != 16
+        or parallel.data_parallel_size != 1
+        or parallel.pipeline_parallel_size != 1
+        or parallel.prefill_context_parallel_size != 1
+        or parallel.decode_context_parallel_size != 1
+        or not parallel.enable_expert_parallel
+        or parallel.enable_eplb
+    ):
+        return False
+    metadata = next(iter(attn_metadata.values()), None)
+    return (
+        getattr(metadata, "num_prefills", None) == 0
+        and metadata.max_query_len == 1
+        and metadata.num_actual_tokens == num_tokens
+        and metadata.num_decodes == num_tokens
+    )
+
