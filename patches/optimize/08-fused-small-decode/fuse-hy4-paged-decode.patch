@@ -0,0 +1,123 @@
+# SPDX-License-Identifier: Apache-2.0
+"""A3 paged-slot gathering and sink softmax for batched HY4 decode."""
+
+import torch
+from vllm.triton_utils import HAS_TRITON, tl, triton
+
+
+def supports_paged_decode(
+    query, query_rope, latent_cache, rope_cache, selected, block_tables, lengths, sinks,
+):
+    return (
+        HAS_TRITON and query.device.type == "npu" and lengths is not None
+        and lengths.device == query.device and lengths.ndim == 1 and lengths.is_contiguous()
+        and lengths.shape[0] >= query.shape[0]
+        and query.dtype == query_rope.dtype == latent_cache.dtype == rope_cache.dtype == torch.bfloat16
+        and latent_cache.shape[-2:] == (1, 512) and rope_cache.shape[-2:] == (1, 64)
+        and latent_cache.is_contiguous() and rope_cache.is_contiguous()
+        and block_tables.stride(-1) == selected.stride(-1) == 1
+        and sinks.dtype == torch.float32 and sinks.is_contiguous()
+        and 1 < query.shape[0] <= 16 and 0 < selected.shape[-1] <= 2048
+    )
+
+
+@triton.jit
+def _gather_paged_inputs(
+    selected_ptr, tables_ptr, lengths_ptr, latent_ptr, rope_ptr, keys_ptr, rotated_ptr,
+    SELECTED_STRIDE: tl.constexpr, TABLE_STRIDE: tl.constexpr, TABLE_WIDTH: tl.constexpr,
+    PAGE: tl.constexpr, WIDTH: tl.constexpr, TILE: tl.constexpr,
+):
+    row = tl.program_id(0)
+    column = tl.program_id(1) * TILE + tl.arange(0, TILE)
+    length = tl.load(lengths_ptr + row)
+    logical = tl.load(selected_ptr + row * SELECTED_STRIDE + column, column < WIDTH, -1)
+    valid = (logical >= 0) & (logical < length) & (logical // PAGE < TABLE_WIDTH)
+    page = tl.load(tables_ptr + row * TABLE_STRIDE + logical // PAGE, valid, 0).to(tl.int64)
+    slot = page * PAGE + logical % PAGE
+    vector = tl.arange(0, 512)
+    rotation = tl.arange(0, 64)
+    keys = tl.load(latent_ptr + slot[:, None] * 512 + vector[None, :], valid[:, None], 0)
+    rotated = tl.load(rope_ptr + slot[:, None] * 64 + rotation[None, :], valid[:, None], 0)
+    target = row * WIDTH + column
+    tl.store(keys_ptr + target[:, None] * 512 + vector[None, :], keys, column[:, None] < WIDTH)
+    tl.store(rotated_ptr + target[:, None] * 64 + rotation[None, :], rotated, column[:, None] < WIDTH)
+
+
+@triton.jit
+def _normalize_with_sink(
+    latent_ptr, rotary_ptr, selected_ptr, lengths_ptr, sink_ptr, weights_ptr,
+    HEADS: tl.constexpr, WIDTH: tl.constexpr, BLOCK: tl.constexpr,
+    SELECTED_STRIDE: tl.constexpr, SCALE: tl.constexpr,
+):
+    head_row = tl.program_id(0)
+    row = head_row // HEADS
+    column = tl.arange(0, BLOCK)
+    length = tl.load(lengths_ptr + row)
+    logical = tl.load(selected_ptr + row * SELECTED_STRIDE + column, column < WIDTH, -1)
+    offset = head_row * WIDTH + column
+    key = tl.load(latent_ptr + offset, column < WIDTH, 0)
+    rotated = tl.load(rotary_ptr + offset, column < WIDTH, 0)
+    logits = tl.where((logical >= 0) & (logical < length), (key + rotated) * SCALE, -float("inf"))
+    sink = tl.load(sink_ptr + head_row % HEADS)
+    maximum = tl.maximum(tl.max(logits, axis=0), sink)
+    numerator = tl.exp(logits - maximum)
+    denominator = tl.sum(numerator, axis=0) + tl.exp(sink - maximum)
+    tl.store(weights_ptr + offset, numerator / denominator, column < WIDTH)
+
+
+def paged_decode_attention(query, query_rope, latent_cache, rope_cache, selected, block_tables, lengths, sinks, scale):
+    rows, heads, _ = query.shape
+    width = selected.shape[-1]
+    keys = torch.empty((rows, width, 512), device=query.device, dtype=torch.float32)
+    rotated = torch.empty((rows, width, 64), device=query.device, dtype=torch.float32)
+    tile = 8
+    _gather_paged_inputs[(rows, triton.cdiv(width, tile))](
+        selected, block_tables, lengths, latent_cache, rope_cache, keys, rotated,
+        selected.stride(0), block_tables.stride(0), block_tables.shape[1],
+        latent_cache.shape[1], width, tile, num_warps=4,
+    )
+    latent_logits = torch.bmm(query.float(), keys.transpose(1, 2))
+    rotary_logits = torch.bmm(query_rope.float(), rotated.transpose(1, 2))
+    weights = torch.empty_like(latent_logits)
+    _normalize_with_sink[(rows * heads,)](
+        latent_logits, rotary_logits, selected, lengths, sinks, weights,
+        heads, width, triton.next_power_of_2(width), selected.stride(0), scale,
+        num_warps=4, enable_fp_fusion=False,
+    )
+    return torch.bmm(weights, keys)
+
+
+def supports_paged_kv_write(latent, rope, latent_cache, rope_cache, slots):
+    return (
+        HAS_TRITON and latent.device.type == "npu"
+        and latent.dtype == rope.dtype == latent_cache.dtype == rope_cache.dtype == torch.bfloat16
+        and latent.shape == (slots.numel(), 512) and rope.shape == (slots.numel(), 64)
+        and latent.stride(-1) == rope.stride(-1) == 1 and slots.is_contiguous()
+        and latent_cache.shape[-2:] == (1, 512) and rope_cache.shape[-2:] == (1, 64)
+        and latent_cache.shape[:2] == rope_cache.shape[:2]
+        and latent_cache.is_contiguous() and rope_cache.is_contiguous() and 0 < slots.numel() <= 16
+    )
+
+
+@triton.jit
+def _write_decode_kv(
+    latent_ptr, rope_ptr, latent_cache_ptr, rope_cache_ptr, slots_ptr,
+    LATENT_STRIDE: tl.constexpr, ROPE_STRIDE: tl.constexpr, CACHE_SLOTS: tl.constexpr,
+):
+    row = tl.program_id(0)
+    slot = tl.load(slots_ptr + row).to(tl.int64)
+    vector = tl.arange(0, 512)
+    rotation = tl.arange(0, 64)
+    latent = tl.load(latent_ptr + row * LATENT_STRIDE + vector)
+    rope = tl.load(rope_ptr + row * ROPE_STRIDE + rotation)
+    valid = (slot >= 0) & (slot < CACHE_SLOTS)
+    tl.store(latent_cache_ptr + slot * 512 + vector, latent, valid)
+    tl.store(rope_cache_ptr + slot * 64 + rotation, rope, valid)
+
+
+def write_paged_decode_kv(latent, rope, latent_cache, rope_cache, slots):
+    _write_decode_kv[(slots.numel(),)](
+        latent, rope, latent_cache, rope_cache, slots,
+        latent.stride(0), rope.stride(0), latent_cache.shape[0] * latent_cache.shape[1],
+        num_warps=4,
+    )
