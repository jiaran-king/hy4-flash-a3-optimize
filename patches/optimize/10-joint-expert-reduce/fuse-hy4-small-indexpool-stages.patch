@@ -0,0 +1,71 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Small-batch IndexPool pooling and causal group expansion on Ascend."""
+
+import torch
+from vllm.triton_utils import HAS_TRITON, tl, triton
+
+
+def supports_small_pool(values, weights):
+    return (
+        HAS_TRITON and values.device.type == "npu" and values.dtype == weights.dtype == torch.float32
+        and values.ndim == 3 and values.shape[1:] == (4, 128)
+        and weights.shape == (128,) and values.is_contiguous() and weights.is_contiguous()
+        and 0 < values.shape[0] <= 16
+    )
+
+
+@triton.jit
+def _pool_rows(values_ptr, gates_ptr, ape_ptr, norm_ptr, output_ptr, EPS: tl.constexpr):
+    group = tl.program_id(0)
+    token = tl.arange(0, 4)
+    cols = tl.arange(0, 128)
+    coords = token[:, None] * 128 + cols[None, :]
+    values = tl.load(values_ptr + group * 512 + coords)
+    logits = tl.load(gates_ptr + group * 512 + coords) + tl.load(ape_ptr + coords)
+    largest = tl.max(logits, axis=0)
+    exponentials = tl.exp(logits - largest[None, :])
+    weights = exponentials / tl.sum(exponentials, axis=0)[None, :]
+    pooled = tl.sum(values * weights, axis=0)
+    inv_rms = tl.rsqrt(tl.sum(pooled * pooled, axis=0) / 128 + EPS)
+    normalized = (pooled * inv_rms) * tl.load(norm_ptr + cols)
+    tl.store(output_ptr + group * 128 + cols, normalized)
+
+
+def pool_small_groups(values, gates, ape, norm, eps):
+    output = torch.empty((values.shape[0], 128), dtype=torch.bfloat16, device=values.device)
+    _pool_rows[(values.shape[0],)](values, gates, ape, norm, output, eps, num_warps=4, enable_fp_fusion=False)
+    return output
+
+
+def supports_small_group_expansion(groups, positions, ratio):
+    return (
+        HAS_TRITON and groups.device.type == "npu" and groups.dtype == torch.int32
+        and positions.ndim == 1 and groups.shape[0] == positions.shape[0]
+        and groups.is_contiguous() and positions.is_contiguous()
+        and 0 < groups.shape[0] <= 16 and groups.shape[1] == 511 and ratio == 4
+    )
+
+
+@triton.jit
+def _expand_rows(groups_ptr, positions_ptr, output_ptr):
+    row = tl.program_id(0)
+    position = tl.load(positions_ptr + row).to(tl.int32)
+    upper = position // 4
+    group_lane = tl.arange(0, 512)
+    all_groups = tl.load(groups_ptr + row * 511 + group_lane, group_lane < 511, -1)
+    count = tl.sum(((position >= 0) & (all_groups >= 0) & (all_groups < upper)).to(tl.int32), axis=0)
+    lane = tl.arange(0, 2048)
+    original = tl.load(groups_ptr + row * 511 + lane // 4, lane < 2044, -1)
+    valid = (position >= 0) & (original >= 0) & (original < upper)
+    history = tl.where(valid, original * 4 + lane % 4, -1)
+    displacement = lane - count * 4
+    tail = upper * 4 + displacement
+    tail = tl.where((position >= 0) & (tail <= position), tail, -1)
+    result = tl.where((displacement >= 0) & (displacement < 4), tail, history)
+    tl.store(output_ptr + row * 2048 + lane, result)
+
+
+def expand_small_groups(groups, positions):
+    output = groups.new_empty((groups.shape[0], 2048))
+    _expand_rows[(groups.shape[0],)](groups, positions, output, num_warps=4)
+    return output
