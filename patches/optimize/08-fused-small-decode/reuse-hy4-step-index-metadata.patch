+def _completed_group_coordinates(block_tables, ranges, ratio, raw_page_size, pool_page_size):
+    owners = []
+    group_ids = []
+    for request, _, _, context, length in ranges:
+        first, end = context // ratio, length // ratio
+        group_ids.extend(range(first, end))
+        owners.extend([request] * (end - first))
+    if not group_ids:
+        return None
+    owners = torch.tensor(owners, device=block_tables.device)
+    group_ids = torch.tensor(group_ids, device=block_tables.device)
+    # Match the IndexPool anchor at each group's first token.
+    starts = group_ids * ratio
+    tokens = starts[:, None] + torch.arange(ratio, device=block_tables.device)
+    raw_pages = block_tables[owners[:, None], tokens // raw_page_size].long()
+    pool_pages = block_tables[owners, group_ids // pool_page_size].long()
+    return starts, raw_pages, tokens % raw_page_size, pool_pages, group_ids % pool_page_size
+
+
+def _shared_completed_groups(context, block_tables, ranges, ratio, raw_page_size, pool_page_size):
+    cache = context.additional_kwargs.setdefault("hy4_indexpool_write_coordinates", {})
+    key = (block_tables.data_ptr(), block_tables.shape, block_tables.stride(),
+           tuple(ranges), ratio, raw_page_size, pool_page_size)
+    if key not in cache:
+        cache[key] = _completed_group_coordinates(block_tables, ranges, ratio, raw_page_size, pool_page_size)
+    return cache[key]
+
