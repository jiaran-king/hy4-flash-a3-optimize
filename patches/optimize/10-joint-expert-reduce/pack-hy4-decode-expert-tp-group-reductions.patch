+# SPDX-License-Identifier: Apache-2.0
+"""Pair HY4 small-decode expert reductions in FP32 before restoring BF16."""
+
+from contextlib import contextmanager
+from dataclasses import dataclass
+
+import torch
+from vllm.distributed import tensor_model_parallel_all_reduce
+from vllm.forward_context import get_forward_context
+
+
+_DEFERRED_REDUCTION = "hy4_deferred_moe_reduction"
+
+
+@dataclass
+class DeferredRoutedSum:
+    output_dtype: torch.dtype | None = None
+
+
+@contextmanager
+def defer_routed_sum():
+    kwargs = get_forward_context().additional_kwargs
+    if _DEFERRED_REDUCTION in kwargs:
+        raise RuntimeError("Nested HY4 expert reduction")
+    state = DeferredRoutedSum()
+    kwargs[_DEFERRED_REDUCTION] = state
+    try:
+        yield state
+    finally:
+        del kwargs[_DEFERRED_REDUCTION]
+
+
+def deferred_routed_sum():
+    return get_forward_context().additional_kwargs.get(_DEFERRED_REDUCTION)
+
+
+def reduce_expert_pair(routed, shared, routed_dtype):
+    if (shared is None or shared.dtype != torch.bfloat16 or routed.dtype != torch.float32
+            or routed_dtype != torch.bfloat16):
+        routed = tensor_model_parallel_all_reduce(routed).to(routed_dtype)
+        if shared is not None:
+            shared = tensor_model_parallel_all_reduce(shared)
+        return routed, shared
+
+    packed = torch.cat((routed.reshape(-1), shared.reshape(-1).float()))
+    packed = tensor_model_parallel_all_reduce(packed)
+    routed_sum, shared_sum = packed.split((routed.numel(), shared.numel()))
+    return routed_sum.view_as(routed).to(routed_dtype), shared_sum.view_as(shared).to(shared.dtype)
