@@ -0,0 +1,86 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Small-batch A3 iHC gate reduction and residual update."""
+import torch
+from vllm.triton_utils import HAS_TRITON, tl, triton
+
+
+def supports_decode_ihc(residual: torch.Tensor) -> bool:
+    return (
+        HAS_TRITON and residual.device.type == "npu" and residual.dtype == torch.bfloat16
+        and residual.ndim == 3 and residual.shape[1:] == (4, 3072)
+        and 0 < residual.shape[0] <= 16 and residual.is_contiguous()
+    )
+
+
+@triton.jit
+def _ihc_gates(
+    residual_ptr, mixes_ptr, scale_ptr, base_ptr, pre_ptr, post_ptr,
+    DIM: tl.constexpr, BLOCK: tl.constexpr, NORM_EPS: tl.constexpr,
+    GATE_EPS: tl.constexpr, MAGNITUDE: tl.constexpr,
+):
+    token = tl.program_id(0)
+    head = tl.arange(0, 4)
+    lane = tl.arange(0, BLOCK)
+    squared = tl.full((BLOCK,), 0, tl.float32)
+    for chunk in range(4 * DIM // BLOCK):
+        values = tl.load(residual_ptr + token * 4 * DIM + chunk * BLOCK + lane).to(tl.float32)
+        squared += values * values
+    mean_square = tl.sum(squared, axis=0) / (4 * DIM)
+    inv_rms = tl.rsqrt(mean_square + NORM_EPS)
+    pre_raw = tl.load(mixes_ptr + token * 8 + head) * inv_rms
+    post_raw = tl.load(mixes_ptr + token * 8 + 4 + head) * inv_rms
+    pre = tl.sigmoid(pre_raw * tl.load(scale_ptr) + tl.load(base_ptr + head)) + GATE_EPS
+    post = MAGNITUDE * tl.sigmoid(
+        post_raw * tl.load(scale_ptr + 1) + tl.load(base_ptr + 4 + head)
+    ) + GATE_EPS
+    tl.store(pre_ptr + token * 4 + head, pre)
+    tl.store(post_ptr + token * 4 + head, post)
+
+
+@triton.jit
+def _ihc_reduce_channels(residual_ptr, pre_ptr, reduced_ptr, DIM: tl.constexpr, BLOCK: tl.constexpr):
+    token = tl.program_id(0)
+    column = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)
+    head = tl.arange(0, 4)
+    residual = tl.load(residual_ptr + (token * 4 + head[:, None]) * DIM + column[None, :],
+                       column[None, :] < DIM, 0).to(tl.float32)
+    pre = tl.load(pre_ptr + token * 4 + head)
+    reduced = tl.sum(residual * pre[:, None], axis=0)
+    tl.store(reduced_ptr + token * DIM + column, reduced, column < DIM)
+
+
+@triton.jit
+def _ihc_update_residual(output_ptr, residual_ptr, post_ptr, updated_ptr, DIM: tl.constexpr, BLOCK: tl.constexpr):
+    branch = tl.program_id(0)
+    column = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)
+    output = tl.load(output_ptr + (branch // 4) * DIM + column, column < DIM, 0).to(tl.float32)
+    residual = tl.load(residual_ptr + branch * DIM + column, column < DIM, 0).to(tl.float32)
+    gate = tl.load(post_ptr + branch)
+    updated = (gate * output) + residual
+    tl.store(updated_ptr + branch * DIM + column, updated, column < DIM)
+
+
+def decode_ihc_pre(residual, mixes, scale, base, norm_eps, gate_eps, magnitude):
+    tokens, _, dim = residual.shape
+    reduced = residual.new_empty((tokens, dim))
+    pre = mixes.new_empty((tokens, 4))
+    post = mixes.new_empty((tokens, 4))
+    _ihc_gates[(tokens,)](
+        residual, mixes, scale, base, pre, post, dim, 4096, norm_eps, gate_eps, magnitude,
+        num_warps=4, enable_fp_fusion=False,
+    )
+    block = 512
+    _ihc_reduce_channels[(tokens, triton.cdiv(dim, block))](
+        residual, pre, reduced, dim, block, num_warps=4, enable_fp_fusion=False,
+    )
+    return reduced, post
+
+
+def decode_ihc_post(output, residual, post):
+    tokens, branches, dim = residual.shape
+    updated = torch.empty_like(residual)
+    block = 512
+    _ihc_update_residual[(tokens * branches, triton.cdiv(dim, block))](
+        output, residual, post, updated, dim, block, num_warps=4, enable_fp_fusion=False,
+    )
+    return updated
