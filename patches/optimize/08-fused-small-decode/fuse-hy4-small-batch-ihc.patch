+class AscendHYV4FlashHCLayer(HYV4HCLayer):
+    def __init__(self, config, layer_idx, prefix):
+        super().__init__(config, layer_idx, prefix=prefix)
+        self.use_a3_ihc = torch.npu.get_device_name().startswith("Ascend910_93")
+
+    def pre(self, hidden_states):
+        if not (self.use_a3_ihc and self.enable_ihc and self.hc_pre.hpc_op is None
